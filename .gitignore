# ============================================================
#  EinoFlow - Git Ignore
#  技术栈：Go 1.25 + Hertz + Eino / Next.js + pnpm / Docker Compose
#  原则：忽略产物、依赖、密钥、本地数据；源码与 lockfile 必须提交
# ============================================================

# ---------- AI 规则文件（暂不纳入版本管理，仅保留在本地）----------
AGENTS.md

# ---------- 操作系统 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.fleet/
*.swp
*.swo
*~

# ---------- 环境变量 / 密钥（切勿提交） ----------
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.crt
*.p12
credentials.json
service-account*.json
secrets/

# ---------- 日志 / 临时文件 ----------
*.log
logs/
.run/
*.tmp
tmp/
.cache/

# ---------- 前端：Node / Next.js / pnpm ----------
node_modules/
.pnpm-store/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/web/.next/
/web/out/
/web/build/
/web/dist/
/web/coverage/
/web/.turbo/
/web/.vercel/
/web/next-env.d.ts
*.tsbuildinfo

# 注意：pnpm-lock.yaml 必须提交，不要忽略

# ---------- 后端：Go / Hertz / Eino ----------
/backend/bin/
/backend/tmp/
/backend/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
coverage.out
coverage.html
__debug_bin*

# ---------- 测试产物 ----------
/web/playwright-report/
/web/test-results/
/web/blob-report/
*.lcov

# ---------- 本地数据卷 / Docker ----------
/data/
/mysql-data/
/redis-data/
