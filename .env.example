# 复制为 .env 后按需修改。
# .env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库。

# ---------- 后端 ----------
EINOFLOW_APP_ENV=dev
EINOFLOW_SERVER_HOST=0.0.0.0
EINOFLOW_SERVER_PORT=8888
EINOFLOW_LOG_LEVEL=info

EINOFLOW_POSTGRES_HOST=127.0.0.1
EINOFLOW_POSTGRES_PORT=5432
EINOFLOW_POSTGRES_USER=einoflow
EINOFLOW_POSTGRES_PASSWORD=einoflow
EINOFLOW_POSTGRES_DATABASE=einoflow
EINOFLOW_POSTGRES_SSLMODE=disable

EINOFLOW_REDIS_HOST=127.0.0.1
EINOFLOW_REDIS_PORT=6379
EINOFLOW_REDIS_PASSWORD=
EINOFLOW_REDIS_DB=0

# Milvus 由本项目 docker-compose.yml 编排（默认 127.0.0.1:19530）
EINOFLOW_MILVUS_ADDRESS=127.0.0.1:19530
EINOFLOW_MILVUS_DATABASE=einoflow
# 分段向量集合名（改它等于换一个向量库，旧集合需自行清理）
EINOFLOW_MILVUS_COLLECTION=einoflow_segments

# 向量化模型（Embedding）：本机 Ollama + bge-m3（1024 维）
# 维度不在配置里写死，服务启动时会向 Ollama 探测并与集合维度校验
EINOFLOW_EMBEDDING_PROVIDER=ollama
EINOFLOW_EMBEDDING_BASE_URL=http://127.0.0.1:11434
EINOFLOW_EMBEDDING_MODEL=bge-m3:latest
EINOFLOW_EMBEDDING_BATCH_SIZE=16

# 检索默认召回条数（1..50）
EINOFLOW_RETRIEVAL_TOP_K=5

# MinIO 对象存储（对应根目录 docker-compose.yml 中的 minio 服务，Milvus 后端存储共用该实例）
EINOFLOW_MINIO_ENDPOINT=127.0.0.1:9000
EINOFLOW_MINIO_ACCESS_KEY=einoflow
EINOFLOW_MINIO_SECRET_KEY=einoflow123
EINOFLOW_MINIO_BUCKET=einoflow

# 文档解析服务（MinerU）
EINOFLOW_MINERU_BASE_URL=http://127.0.0.1:8000
EINOFLOW_MINERU_TIER=basic

# ---------- 本地基础设施（docker compose 读取） ----------
POSTGRES_USER=einoflow
POSTGRES_PASSWORD=einoflow
POSTGRES_DB=einoflow

MINIO_ROOT_USER=einoflow
MINIO_ROOT_PASSWORD=einoflow123

# ---------- 公网演示（Cloudflare 隧道）----------
# 配置步骤见 deploy/cloudflared/README.md；留空则 make tunnel-up 会提示报错。
CF_TUNNEL_TOKEN=

# 公网演示域名（仅用于脚本展示访问地址，不影响功能）
EINOFLOW_DEMO_DOMAIN=einoflow.sql668.com
