# 复制为 .env 后按需修改。
# .env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库。

# ---------- 后端 ----------
EINOFLOW_APP_ENV=dev
EINOFLOW_SERVER_HOST=0.0.0.0
EINOFLOW_SERVER_PORT=8888
EINOFLOW_LOG_LEVEL=info

EINOFLOW_MYSQL_HOST=127.0.0.1
EINOFLOW_MYSQL_PORT=3306
EINOFLOW_MYSQL_USER=einoflow
EINOFLOW_MYSQL_PASSWORD=einoflow
EINOFLOW_MYSQL_DATABASE=einoflow

EINOFLOW_REDIS_HOST=127.0.0.1
EINOFLOW_REDIS_PORT=6379
EINOFLOW_REDIS_PASSWORD=
EINOFLOW_REDIS_DB=0

# Milvus 由本项目 docker-compose.yml 编排（默认 127.0.0.1:19530）
EINOFLOW_MILVUS_ADDRESS=127.0.0.1:19530
EINOFLOW_MILVUS_DATABASE=einoflow

# MinIO 对象存储（对应根目录 docker-compose.yml 中的 minio 服务，Milvus 后端存储共用该实例）
EINOFLOW_MINIO_ENDPOINT=127.0.0.1:9000
EINOFLOW_MINIO_ACCESS_KEY=einoflow
EINOFLOW_MINIO_SECRET_KEY=einoflow123
EINOFLOW_MINIO_BUCKET=einoflow

# ---------- 本地基础设施（docker compose 读取） ----------
MYSQL_ROOT_PASSWORD=einoflow_root
MYSQL_DATABASE=einoflow
MYSQL_USER=einoflow
MYSQL_PASSWORD=einoflow

MINIO_ROOT_USER=einoflow
MINIO_ROOT_PASSWORD=einoflow123

# ---------- 公网演示（Cloudflare 隧道）----------
# 配置步骤见 deploy/cloudflared/README.md；留空则 make tunnel-up 会提示报错。
CF_TUNNEL_TOKEN=

# 公网演示域名（仅用于脚本展示访问地址，不影响功能）
EINOFLOW_DEMO_DOMAIN=einoflow.sql668.com
